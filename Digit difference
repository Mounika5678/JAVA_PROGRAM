class Solution {
    public boolean isValid(String s) {

        for (int i = 0; i < s.length() - 1; i++) {

            

            int diff = s.charAt(i)-s.charAt(i+1);

            if (diff < 0) {
                diff = -diff;
            }

            if (diff > 2) {
                return false;
            }
        }

        return true;
    }
}
